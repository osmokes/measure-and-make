# Dependencies (reinstalled from package-lock.json with `npm install`)
node_modules/

# Build output (regenerated by `npm run build`)
dist/

# Astro's generated types and cache
.astro/

# Environment variables / secrets — never commit these
.env
.env.*

# Logs
npm-debug.log*

# Operating system files
.DS_Store
Thumbs.db

# Editor settings: personal, except the shared list of recommended extensions
.vscode/*
!.vscode/extensions.json
