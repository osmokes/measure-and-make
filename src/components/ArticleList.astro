---
// A list of article summaries, used on the home page, the archive and
// topic pages.
import FormattedDate from "./FormattedDate.astro";
import type { Article } from "../lib/articles";
import { getTopicMap, topicOf } from "../lib/topics";
import { readingTimeLabel } from "../lib/reading-time";

interface Props {
  articles: Article[];
  /** Show each article's topic next to its date. Off on topic pages. */
  showTopic?: boolean;
}

const { articles, showTopic = true } = Astro.props;

// Pair each article with its topic up front, so the template stays simple.
// topicOf() throws (stopping the build) if a topic id is misspelt.
const topics = await getTopicMap();
const items = articles.map((article) => ({
  article,
  topic: topicOf(article, topics),
}));
---

{
  items.length === 0 ? (
    <p class="empty">No articles yet.</p>
  ) : (
    <ol class="article-list">
      {items.map(({ article, topic }) => (
        <li>
          <h2>
            <a href={`/articles/${article.id}/`}>{article.data.title}</a>
            {article.data.draft && <span class="draft">Draft</span>}
          </h2>
          <p>{article.data.description}</p>
          {/* A <p> owned by this component, because scoped styles here
              can't reach the <time> that FormattedDate renders. */}
          <p class="meta">
            <FormattedDate date={article.data.pubDate} />
            {` · ${readingTimeLabel(article.body ?? "")}`}
            {showTopic && (
              <>
                {" · "}
                <a href={`/topics/${topic.id}/`}>{topic.data.name}</a>
              </>
            )}
          </p>
        </li>
      ))}
    </ol>
  )
}

<style>
  .article-list {
    list-style: none;
    padding: 0;
  }
  .article-list li + li {
    margin-top: var(--space-5);
  }
  h2 {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-2);
  }
  h2 a {
    color: var(--color-text);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--color-accent);
  }
  p {
    margin: 0 0 var(--space-1);
  }
  .meta,
  .empty {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .meta a {
    color: var(--color-muted);
  }
  .meta a:hover {
    color: var(--color-accent);
  }
  .draft {
    margin-left: var(--space-2);
    padding: 0.1em 0.5em;
    border: 1px solid var(--color-accent);
    border-radius: 3px;
    color: var(--color-accent);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 500;
    vertical-align: middle;
  }
</style>
