---
import { SITE_TITLE, LICENCE } from "../consts";

// Runs at build time, so this is the year the site was last built.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p>
    &copy; {year} {SITE_TITLE}. Articles are licensed under
    <a href={LICENCE.url} rel="license">{LICENCE.name}</a>.
  </p>
  <p>
    <a href="/rss.xml">RSS feed</a>
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-6);
    padding: var(--space-4) 0 var(--space-5);
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .site-footer p {
    margin: 0;
  }
  .site-footer a {
    color: inherit;
  }
  .site-footer a:hover {
    color: var(--color-accent);
  }
</style>
