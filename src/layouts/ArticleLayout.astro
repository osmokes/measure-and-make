---
// Wraps a single article: header (topic, title, standfirst, dates, reading
// time), contents list, body, and "More in <topic>", inside BaseLayout.
import type { MarkdownHeading } from "astro";
import { getImage } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import TableOfContents from "../components/TableOfContents.astro";
import MoreInTopic from "../components/MoreInTopic.astro";
import type { Article } from "../lib/articles";
import { getTopicMap, topicOf } from "../lib/topics";
import { readingTimeLabel } from "../lib/reading-time";

interface Props {
  article: Article;
  /** The article's headings, from render(). */
  headings: MarkdownHeading[];
  /** Other articles in the same topic, newest first. */
  related: Article[];
}

const { article, headings, related } = Astro.props;
const { title, description, pubDate, updatedDate, draft, image, imageAlt } =
  article.data;
const topic = topicOf(article, await getTopicMap());
const readingTime = readingTimeLabel(article.body ?? "");

// Cover image for link previews only (never shown on the page). getImage()
// makes a 1200 px wide JPEG, a size and format every preview service accepts.
if (image?.format === "svg") {
  throw new Error(
    `Article "${article.id}": the cover image can't be an SVG (link previews ` +
      `don't support it). Export it as PNG or JPG instead.`,
  );
}
const cover = image && (await getImage({ src: image, width: 1200, format: "jpeg" }));
const ogImage = cover && {
  src: cover.src,
  width: Number(cover.attributes.width),
  height: Number(cover.attributes.height),
  alt: imageAlt ?? "",
};
---

<BaseLayout title={title} description={description} ogType="article" ogImage={ogImage}>
  {/* Pass any slot="head" content from the page on to BaseLayout's <head>. */}
  <slot name="head" slot="head" />
  {/* Article dates for link previews and search engines. */}
  <meta slot="head" property="article:published_time" content={pubDate.toISOString()} />
  {
    updatedDate && (
      <meta slot="head" property="article:modified_time" content={updatedDate.toISOString()} />
    )
  }
  <meta slot="head" property="article:section" content={topic.data.name} />
  {/* data-pagefind-body: only this part of the site goes into the search
       index, so results point at articles rather than lists that repeat
       their titles. */}
  <article data-pagefind-body>
    <header class="article-header">
      {draft && <p class="draft-notice">Draft: not included in the built site.</p>}
      <p class="topic">
        <a href={`/topics/${topic.id}/`}>{topic.data.name}</a>
      </p>
      <h1>{title}</h1>
      <p class="standfirst">{description}</p>
      <p class="dates">
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <>
              {" · Updated "}
              <FormattedDate date={updatedDate} />
            </>
          )
        }
        {` · ${readingTime}`}
      </p>
    </header>
    {/* data-pagefind-ignore keeps the contents list out of search results. */}
    <div data-pagefind-ignore>
      <TableOfContents headings={headings} />
    </div>
    {/* The rendered Markdown goes here. */}
    <slot />
  </article>
  <MoreInTopic topic={topic} articles={related} />
</BaseLayout>

<style>
  .article-header {
    margin-bottom: var(--space-5);
  }
  .article-header h1 {
    margin-bottom: var(--space-3);
  }
  .standfirst {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-3);
  }
  .dates,
  .draft-notice {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin: 0;
  }
  .draft-notice {
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }
  /* Small label above the title, like a newspaper section name. */
  .topic {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 var(--space-2);
  }
  .topic a {
    text-decoration: none;
  }
  .topic a:hover {
    text-decoration: underline;
  }
</style>
