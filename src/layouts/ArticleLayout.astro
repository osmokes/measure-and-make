---
// Wraps a single article: header (topic, title, standfirst, dates) and body,
// inside the site-wide BaseLayout.
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import type { Article } from "../lib/articles";
import { getTopicMap, topicOf } from "../lib/topics";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title, description, pubDate, updatedDate, draft } = article.data;
const topic = topicOf(article, await getTopicMap());
---

<BaseLayout title={title} description={description} ogType="article">
  {/* Pass any slot="head" content from the page on to BaseLayout's <head>. */}
  <slot name="head" slot="head" />
  {/* Article dates for link previews and search engines. */}
  <meta slot="head" property="article:published_time" content={pubDate.toISOString()} />
  {
    updatedDate && (
      <meta slot="head" property="article:modified_time" content={updatedDate.toISOString()} />
    )
  }
  <meta slot="head" property="article:section" content={topic.data.name} />
  <article>
    <header class="article-header">
      {draft && <p class="draft-notice">Draft: not included in the built site.</p>}
      <p class="topic">
        <a href={`/topics/${topic.id}/`}>{topic.data.name}</a>
      </p>
      <h1>{title}</h1>
      <p class="standfirst">{description}</p>
      <p class="dates">
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <>
              {" · Updated "}
              <FormattedDate date={updatedDate} />
            </>
          )
        }
      </p>
    </header>
    {/* The rendered Markdown goes here. */}
    <slot />
  </article>
</BaseLayout>

<style>
  .article-header {
    margin-bottom: var(--space-5);
  }
  .article-header h1 {
    margin-bottom: var(--space-3);
  }
  .standfirst {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-3);
  }
  .dates,
  .draft-notice {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin: 0;
  }
  .draft-notice {
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }
  /* Small label above the title, like a newspaper section name. */
  .topic {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 var(--space-2);
  }
  .topic a {
    text-decoration: none;
  }
  .topic a:hover {
    text-decoration: underline;
  }
</style>
