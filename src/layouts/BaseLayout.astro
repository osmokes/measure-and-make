---
// The shared HTML shell for every page. A page uses it like this:
//
//   <BaseLayout title="About">
//     ...page content...
//   </BaseLayout>
//
// and its content is inserted where <slot /> appears below.
import { Font } from "astro:assets";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import "../styles/global.css";

interface Props {
  /** Page title. Omit it on the home page to show just the site name. */
  title?: string;
  /** Text for search results and link previews. */
  description?: string;
  /** "article" for articles; "website" for everything else (link previews). */
  ogType?: "website" | "article";
  /** Ask search engines not to list this page (test pages, 404). */
  noindex?: boolean;
  /** Link-preview image: a site-relative URL plus its size and description. */
  ogImage?: { src: string; width: number; height: number; alt: string };
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogType = "website",
  noindex = false,
  ogImage,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;

// The full address of this page, e.g. https://example.com/articles/x/.
// Astro.site comes from `site` in astro.config.mjs.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const rssUrl = new URL("/rss.xml", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* The one official address of this page, for search engines. */}
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Lets browsers and feed readers discover the RSS feed. */}
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={rssUrl} />

    {/* Open Graph: how the page looks when its link is shared (Slack,
         Mastodon, LinkedIn...). Twitter/X reads these too. */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_GB" />
    {
      ogImage && (
        <>
          {/* Preview images must be full URLs, so prefix the site address. */}
          <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
          <meta property="og:image:width" content={String(ogImage.width)} />
          <meta property="og:image:height" content={String(ogImage.height)} />
          <meta property="og:image:alt" content={ogImage.alt} />
        </>
      )
    }
    {/* With an image, ask for the large preview card instead of the small one. */}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    {/* Pages can add their own <head> tags (e.g. article dates) with slot="head". */}
    <slot name="head" />

    {/* Browser UI colour (e.g. mobile address bar) for each scheme. */}
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161514" media="(prefers-color-scheme: dark)" />
    {/* Emits the @font-face rules. Only the upright (normal) file is preloaded,
         because every page needs it straight away; italic loads when used. */}
    <Font cssVariable="--font-serif" preload={[{ style: "normal" }]} />
  </head>
  <body>
    <div class="page">
      <SiteHeader />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

<style>
  /* Centre the content and cap its width at a comfortable reading measure.
     min() keeps a gutter on narrow screens. */
  .page {
    width: min(var(--measure), 100% - 2 * var(--gutter));
    margin-inline: auto;
  }
</style>
