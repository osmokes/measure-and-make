---
// One file, many pages. The [slug] in the filename is a placeholder: at build
// time Astro calls getStaticPaths() and writes one HTML page per article,
// e.g. /articles/how-bridges-carry-load/.
import { render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getArticles, type Article } from "../../lib/articles";
// `?url` gives us the stylesheet's final URL instead of adding it to every
// page built from this file. We then link it only where it's needed.
import katexCssUrl from "katex/dist/katex.min.css?url";

export async function getStaticPaths() {
  const articles = await getArticles(); // newest first
  return articles.map((article) => ({
    params: { slug: article.id }, // fills in [slug]
    props: {
      article,
      // Other articles in the same topic, for "More in <topic>".
      related: articles.filter(
        (other) =>
          other.id !== article.id && other.data.topic.id === article.data.topic.id,
      ),
    }, // passed to this page as Astro.props
  }));
}

interface Props {
  article: Article;
  related: Article[];
}

const { article, related } = Astro.props;
// Turn the article's Markdown into HTML. <Content /> outputs it.
// `headings` lists every heading with its id, for the table of contents.
// remarkPluginFrontmatter holds data added by Markdown plugins; our KaTeX
// plugin (plugins/katex.mjs) sets hasMath when the article contains maths.
const { Content, headings, remarkPluginFrontmatter } = await render(article);
const hasMath = remarkPluginFrontmatter.hasMath === true;
---

<ArticleLayout article={article} headings={headings} related={related}>
  {hasMath && <link slot="head" rel="stylesheet" href={katexCssUrl} />}
  <Content />
</ArticleLayout>
