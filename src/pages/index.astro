---
// Home page ("/"): introduction plus the latest articles.
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleList from "../components/ArticleList.astro";
import { getArticles } from "../lib/articles";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const LATEST_COUNT = 5;
const articles = await getArticles();
const latest = articles.slice(0, LATEST_COUNT);
---

<BaseLayout>
  {/* Every page needs one <h1> for screen readers and search engines. The
       site name is already visible in the header, so hide this one visually. */}
  <h1 class="visually-hidden">{SITE_TITLE}</h1>
  <p class="intro">{SITE_DESCRIPTION}</p>
  <ArticleList articles={latest} />
  {
    articles.length > LATEST_COUNT && (
      <p>
        <a href="/articles/">All articles →</a>
      </p>
    )
  }
</BaseLayout>

<style>
  .intro {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-5);
  }
</style>
